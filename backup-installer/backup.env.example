# 安装目录中的实际配置文件会叫 backup.env

# ===== 必填项 =====
WEBDAV_DOMAIN="https://example.com"
WEBDAV_USERNAME="your-username"
WEBDAV_PASSWORD="your-password"
WEBDAV_PATH="OneDrive/Backup/vps"
SERVER_ID="your-server-id"
BACKUP_SOURCES="/root/.openclaw /root/docker"

# ===== 可选项 =====
EXCLUDE_PATTERNS='*.db-wal
*.db-shm
.openclaw/extensions'
ARCHIVE_TMP_DIR="/tmp"
RCLONE_REMOTE_NAME="openlist"
RETENTION_DAYS="3"
ARCHIVE_PREFIX="backup"
# REMOTE_DIR="OneDrive/Backup/vps/your-server-id"
# WEBDAV_BASE="https://example.com/dav"
# RCLONE_EXTRA_ARGS="--transfers 1"
